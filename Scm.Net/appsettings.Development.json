{
  "AllowedHosts": "*",
  "Serilog": {
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "MinimumLevel": "Debug",
    "Properties": {
      "Application": "C-SCM"
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u11}] [ThreadId:{ThreadId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      // HTTP 端点
      "Http": {
        "Url": "http://*:5000" // 监听所有IP的5000端口
      }
    },
    // 全局限制（可选）
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxRequestBodySize": 104857600 // 100MB（单位：字节）
    }
  },
  "Env": {
    "dataUri": "/data",
    "dataDir": "dev",
    "upload": "upload",
    "images": "images",
    "logs": "logs",
    "fonts": "fonts",
    "defaultFont": "Open Sans",
    // 版本检测地址
    "CheckUpgradeUrl": "",
    "UpgradeFilePath": "Upgrade/Upgrade.Cmd.exe",
    "UpgradeJsonPath": "Upgrade/Upgrade.json"
  },
  "Uid": {
    "Type": "Compose",
    "DbType": "file",
    "DbText": "D:/data/uid.db"
  },
  "Sql": {
    // Sqlite
    "Type": "Sqlite",
    "Text": "Data Source=D:/data/scm.db;"
    //"Type": "MySQL",
    //"Text": "Server=127.0.0.1;Port=3306;Database=scm;Uid=root;Pwd=123456;CharSet=utf8mb4;"
    //"Type": "SQLServer",
    //"Text": "Data Source=127.0.0.1,1433;Initial Catalog=scm;User ID=sa;Password=123456;TrustServerCertificate=True;"
    //"Type": "PostgreSQL",
    //"Text": "Host=127.0.0.1;Port=5432;Database=scm;Username=postgres;Password=123456;Encoding=UTF8;"
  },
  "Cache": {
    "Type": "Redis",
    "Text": "127.0.0.1,defaultDatabase=5,poolsize=10"
  },
  "Quartz": {
    "Type": "file",
    "BaseDir": "quartz",
    "DataDir": "data",
    "LogsDir": "logs",
    "JobFile": "jobs.json"
  },
  "Oidc": {
    "app_key": "08dc965832db7248",
    "app_secret": "50qvwk2mynnxiq20rgzrx8w8s94kfaml",
    "redirect_uri": "http://localhost:2800/#/oauth",
    "scope": "openid"
  },
  "Otp": {
    "Type": "TOTP",
    "Hotp": {
      "Algorithm": "SHA1",
      "Issuer": "Scm.Net",
      "Digits": 6,
      "Period": 30,
      "Window": 1,
      "Template": "otpauth://totp/{issuer}:{account}?secret={secret}&issuer={issuer}&algorithm={algorithm}&digits={digits}&period={period}"
    },
    "Totp": {
      "Algorithm": "SHA1",
      "Issuer": "Scm.Net",
      "Digits": 6,
      "Period": 30,
      "Window": 1,
      "Template": "otpauth://totp/{issuer}:{account}?secret={secret}&issuer={issuer}&algorithm={algorithm}&digits={digits}&period={period}"
    },
    "Phone": {

    },
    "Email": {
      "SmtpServer": "smtp.exmail.qq.com",
      "SmtpPort": 465,
      "Username": "你的邮箱账号",
      "Password": "你的邮箱密码",
      "Sender": "C-SCM"
    }
  },
  "Generator": {
    "TemplatesDir": "templates",
    "GeneratorDir": "generator",
    "SearchEnabledColumns": [ "codes", "codec", "names" ],
    "ResultIgnoredColumns": [ "id" ],
    "UpdateIgnoredColumns": [ "id", "row_status", "update_time", "update_user", "create_time", "create_user" ],
    "GenFiles": true,
    "Download": true
  },
  "Jwt": {
    "Security": "a89f374d796890b0a05c6da2478e2569",
    "Issuer": "Scm.Net",
    "Audience": "scm.net",
    "Expires": 30
  },
  "Security": {
    "AppKey": "",
    "AesKey": "",
    "SignKey": "",
    "DesKey": ""
  },
  "Project": {
    "Service": [ "Scm.Core" ]
  },
  "Cors": {
    "GlobalCors": true,
    "AllowAnyOrigin": false,
    "AllowedOrigins": [ "http://localhost:2800", "https://localhost:2800" ],
    "AllowAnyMethod": true,
    "AllowedMethods": [ "GET" ],
    "AllowAnyHeader": true,
    "AllowedHeaders": [ "Content-Type" ],
    "AllowCredentials": true,
    "ExposedHeaders": [ "X-Refresh-Token" ],
    "PreflightMaxAge": 1
  },
  "MqttBroker": {
    "Enabled": false,
    "Port": 1883,
    "RequireAuthentication": false
  },
  "MqttClient": {
    "Enabled": true,
    "Host": "106.14.146.154",
    "Port": 1883
  },

  "Swagger": {
    "Title": "Scm.Net API 文档",
    "Description": "系统管理平台 API 接口文档",
    "Version": "v1.0",
    "OpenApiRoute": "/openapi/v1.json",
    "SwaggerRoute": "/scalar"
  },
  "Ai": {
    "ChatProvider": "qwen",
    "EmbeddingProvider": "qwen",
    "DeepSeek": {
      "BaseUrl": "https://api.deepseek.com/v1",
      "ApiKey": "",
      "ChatModel": "deepseek-chat",
      "Timeout": 300
    },
    "Qwen": {
      "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "ApiKey": "",
      "ChatModel": "qwen-plus",
      "EmbeddingModel": "text-embedding-v3",
      "Timeout": 300
    },
    "Rag": {
      "DocDir": "ai/docs",
      "ChunkSize": 500,
      "ChunkOverlap": 50,
      "TopK": 4,
      "MinScore": 0.2,
      "EmbedBatch": 6
    }
  },
  "Scalar": {
    "Title": "Scm.Net API 文档",
    "Description": "系统管理平台 API 接口文档",
    "Version": "v1.0",
    "OpenApiRoute": "/openapi/{documentName}.json",
    "ScalarRoute": "/scalar",
    "ShowInProduction": false,
    "DllXmls": [ "Scm.Api.xml", "Scm.Core.xml", "Scm.Dao.xml" ],
    "ApiDocs": [
      {
        "Group": "scm",
        "Title": "平台通用",
        "Version": "v1",
        "Description": "工作台、操作员等通用接口"
      },
      {
        "Group": "test",
        "Title": "测试功能",
        "Version": "v1",
        "Description": "测试相关的功能接口"
      },
      {
        "Group": "sys",
        "Title": "系统管理",
        "Version": "v1",
        "Description": "菜单、文件、日历、配置等系统管理接口"
      },
      {
        "Group": "ur",
        "Title": "用户权限",
        "Version": "v1",
        "Description": "用户、角色、授权等权限接口"
      },
      {
        "Group": "adm",
        "Title": "管理后台",
        "Version": "v1",
        "Description": "后台管理接口"
      },
      {
        "Group": "msg",
        "Title": "消息中心",
        "Version": "v1",
        "Description": "通知、站内信、聊天等消息接口"
      },
      {
        "Group": "ai",
        "Title": "AI大模型",
        "Version": "v1",
        "Description": "智能问答、流式对话、RAG知识库接口"
      },
      {
        "Group": "log",
        "Title": "日志中心",
        "Version": "v1",
        "Description": "操作日志、登录日志等接口"
      },
      {
        "Group": "dev",
        "Title": "开发工具",
        "Version": "v1",
        "Description": "菜单开发、数据库工具等接口"
      },
      {
        "Group": "cfg",
        "Title": "配置中心",
        "Version": "v1",
        "Description": "导入导出配置等接口"
      },
      {
        "Group": "res",
        "Title": "资源管理",
        "Version": "v1",
        "Description": "应用、图标、分类、标签等资源接口"
      },
      {
        "Group": "dr",
        "Title": "数据报表",
        "Version": "v1",
        "Description": "报表数据接口"
      },
      {
        "Group": "gtd",
        "Title": "待办任务",
        "Version": "v1",
        "Description": "待办任务接口"
      },
      {
        "Group": "chat",
        "Title": "在线聊天",
        "Version": "v1",
        "Description": "聊天会话接口"
      },
      {
        "Group": "about",
        "Title": "关于",
        "Version": "v1",
        "Description": "系统信息接口"
      },
      {
        "Group": "samples",
        "Title": "示例接口",
        "Version": "v1",
        "Description": "Samples示例模块接口"
      }
    ]
  }
}