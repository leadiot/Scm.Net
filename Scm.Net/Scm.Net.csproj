<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>Com.Scm</RootNamespace>
		<StartupObject>Com.Scm.Program</StartupObject>
		<ApplicationIcon>Resources\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Resources\logo.ico" />
		<Content Remove="data\quartz\data\jobs.json" />
		<Content Remove="data\unit-origin.json" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="dev\**" />
		<Compile Remove="logs\**" />
		<Compile Remove="Publish\**" />
		<Content Remove="dev\**" />
		<Content Remove="logs\**" />
		<Content Remove="Publish\**" />
		<None Remove="dev\**" />
		<None Remove="logs\**" />
		<None Remove="Publish\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Samples.Server\Samples.Server.csproj" />
		<ProjectReference Include="..\Scm.Common\Scm.Common.csproj" />
		<ProjectReference Include="..\Scm.Core\Scm.Core.csproj" />
		<ProjectReference Include="..\Scm.Email\Scm.Email.csproj" />
		<ProjectReference Include="..\Scm.Generator\Scm.Generator.csproj" />
		<ProjectReference Include="..\Scm.Mqtt\Scm.Mqtt.csproj" />
		<ProjectReference Include="..\Scm.Server.Cache\Scm.Server.Cache.csproj" />
		<ProjectReference Include="..\Scm.Server.MQTT\Scm.Server.MQTT.csproj" />
		<ProjectReference Include="..\Scm.Server.Quartz\Scm.Server.Quartz.csproj" />
		<ProjectReference Include="..\Scm.Server.Scalar\Scm.Server.Scalar.csproj" />
		<ProjectReference Include="..\Scm.Server.Service\Scm.Server.Service.csproj" />
		<ProjectReference Include="..\Scm.Server.SignalR\Scm.Server.SignalR.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Settings.Configuration" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="SixLabors.Fonts" />
