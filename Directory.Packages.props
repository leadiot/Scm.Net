<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft / 框架">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageVersion Include="System.Management" Version="11.0.0" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="数据访问 / 导入导出">
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageVersion Include="CsvHelper" Version="34.0.0" />
    <PackageVersion Include="MiniExcel" Version="1.47.0" />
  </ItemGroup>

  <ItemGroup Label="调度 / 消息 / 通知">
    <PackageVersion Include="Quartz" Version="4.7.3" />
    <PackageVersion Include="Quartz.AspNetCore" Version="4.7.3" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="MimeKit" Version="5.0.0" />
    <PackageVersion Include="AlibabaCloud.SDK.Dysmsapi20170525" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup Label="序列化 / 对象映射 / API 文档">
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Mapster" Version="10.0.14" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup Label="日志">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="图像处理（SixLabors 为 Scm.Plugin.Image.ImageSharp 的运行时依赖，代码中无直接调用，勿按“未引用”删除）">
    <PackageVersion Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

</Project>
